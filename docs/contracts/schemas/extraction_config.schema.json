{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psf-field.local/schemas/extraction_config.schema.json",
  "title": "ExtractionConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fwhm"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "box_size": { "type": "integer", "minimum": 32, "maximum": 128, "default": 64 },
    "filter_size": { "type": "integer", "enum": [1, 3, 5], "default": 3 },
    "sigma_clip_sigma": { "type": "number", "minimum": 2.0, "maximum": 5.0, "default": 3.0 },
    "sigma_clip_maxiters": { "type": "integer", "minimum": 3, "maximum": 10, "default": 5 },
    "fwhm": { "type": "number", "exclusiveMinimum": 1.0 },
    "n_sigma": { "type": "number", "minimum": 3.0, "maximum": 10.0, "default": 5.0 },
    "sharpness_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" },
      "default": [0.2, 1.0]
    },
    "roundness_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" },
      "default": [-1.0, 1.0]
    },
    "min_separation_fwhm": { "type": "number", "minimum": 0.5, "maximum": 3.0, "default": 1.0 },
    "snr_min": { "type": "number", "minimum": 10, "maximum": 50, "default": 20 },
    "max_selected": { "type": "integer", "minimum": 50, "maximum": 2000, "default": 400 },
    "selection_mode": {
      "type": "string",
      "enum": ["highest_snr", "snr_by_cell"],
      "default": "highest_snr"
    },
    "holdout_fraction": { "type": "number", "minimum": 0, "maximum": 0.5, "default": 0 },
    "holdout_seed": { "type": "integer", "minimum": 0 }
  }
}
